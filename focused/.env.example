# OpenCode Go (OpenAI-compatible API)
OPENCODE_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: avoids an auth.users lookup on each cold start.
DEFAULT_OWNER_USER_ID=
# Task reminders are delivered to the Hermes receiver running on the VM.
HERMES_REMINDER_WEBHOOK_URL=
HERMES_REMINDER_WEBHOOK_SECRET=
